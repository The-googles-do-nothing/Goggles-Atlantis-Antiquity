<Database>
	<EnglishText>
		<Row Tag="LOC_WONDER_TEMPLE_OF_POSEIDON_NAME">
			<Text>Temple of Poseidon</Text>
		</Row>
		<Row Tag="LOC_WONDER_TEMPLE_OF_POSEIDON_DESCRIPTION">
			<Text>{LOC_WONDER_TEMPLE_OF_POSEIDON_TOOLTIP}</Text>
		</Row>
		<Row Tag="LOC_WONDER_TEMPLE_OF_POSEIDON_TOOLTIP">
			<Text>+2 [icon:YIELD_HAPPINESS] on City Hall buildings. Ageless. Must be built next to the capital.</Text>
		</Row>
		<Row Tag="LOC_QUOTE_WONDER_TEMPLE_OF_POSEIDON">
			<Text>Place me on Sunium's marbled steep / Where nothing save the waves and I / May hear our mutual murmurs sweep.</Text>
		</Row>
		<Row Tag="LOC_QUOTE_AUTHOR_WONDER_TEMPLE_OF_POSEIDON">
			<Text>Lord Byron</Text>
		</Row>

    </EnglishText>
</Database>