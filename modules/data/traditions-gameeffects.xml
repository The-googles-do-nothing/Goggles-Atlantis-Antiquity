<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- Tradition: Critias: +1 Gold per specialists. -->


	<Modifier id="MOD_ATLANTIS_JEC_CRITIAS_I_CULTURE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_ADJACENCY_FLAT_AMOUNT">
		<Argument name="Adjacency_YieldChange">QuarterCulture</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="Divisor">1</Argument>
		<String context="Description">LOC_TRADITION_ATLANTIS_JEC_SYNCRETISM_EXPLORATION_DESCRIPTION</String>
	</Modifier>
	<Modifier id="MOD_ATLANTIS_JEC_CRITIAS_I_SCIENCE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_ADJACENCY_FLAT_AMOUNT">
		<Argument name="Adjacency_YieldChange">QuarterScience</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="Divisor">1</Argument>
	</Modifier>

	<!-- Sixth portion: Settlements receive increased Gold based on Urban Population  -->
	<Modifier id="MOD_JEC_SIXTH_PORTION_CAVALRY_ABILITY" collection="COLLECTION_PLAYER_UNITS" effect="EFFECT_UNIT_ADJUST_ABILITY">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_UNIT_TAG_MATCHES">
				<Argument name="Tag">UNIT_CLASS_CAVALRY</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="AbilityType">ABILITY_SIXTH_PORTION</Argument>
		<String context="Description">LOC_TRADITION_ATLANTIS_SIXTH_PORTION_COMBAT_DESCRIPTION</String>
	</Modifier>

	<Modifier id="TRADITION_ATLANTIS_SIXTH_PORTION_MOD_UNIT_MAINTENANCE" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_UNIT_MAINTENANCE_EFFICIENCY">
		<Argument name="Percent">-100</Argument>
		<Argument name="UnitTag">UNIT_CLASS_CAVALRY</Argument>
		<String context="Preview">LOC_TRADITION_ATLANTIS_SIXTH_PORTION_MOD_NAME</String>
		<String context="Description">LOC_TRADITION_ATLANTIS_SIXTH_PORTION_MAINTAIN_DESCRIPTION</String>
	</Modifier>

	<!-- exploration -->
	<Modifier id="MOD_ATLANTIS_JEC_CRITIAS_II_CULTURE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_ADJACENCY_FLAT_AMOUNT">
		<Argument name="Adjacency_YieldChange">QuarterCulture</Argument>
		<Argument name="Amount">2</Argument>
		<Argument name="Divisor">1</Argument>
		<String context="Description">LOC_TRADITION_ATLANTIS_JEC_SYNCRETISM_EXPLORATION_DESCRIPTION</String>
	</Modifier>
	<Modifier id="MOD_ATLANTIS_JEC_CRITIAS_II_SCIENCE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_ADJACENCY_FLAT_AMOUNT">
		<Argument name="Adjacency_YieldChange">QuarterScience</Argument>
		<Argument name="Amount">3</Argument>
		<Argument name="Divisor">1</Argument>
	</Modifier>

	<!-- modern -->
	<Modifier id="MOD_ATLANTIS_JEC_CRITIAS_III_CULTURE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_ADJACENCY_FLAT_AMOUNT">
		<Argument name="Adjacency_YieldChange">QuarterCulture</Argument>
		<Argument name="Amount">3</Argument>
		<Argument name="Divisor">1</Argument>
		<String context="Description">LOC_TRADITION_ATLANTIS_JEC_SYNCRETISM_MODERN_DESCRIPTION</String>
	</Modifier>
	<Modifier id="MOD_ATLANTIS_JEC_CRITIAS_III_SCIENCE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_ADJACENCY_FLAT_AMOUNT">
		<Argument name="Adjacency_YieldChange">QuarterScience</Argument>
		<Argument name="Amount">3</Argument>
		<Argument name="Divisor">1</Argument>
	</Modifier>

	<!-- ==================================================	-->
	<!--	Unlock Syncretism Traditions				-->
	<!-- ==================================================	-->
	<Modifier id="MOD_UNLOCK_ATLANTIS_JEC_SYNCRETISM_EXPLORATION" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_UNLOCK_TRADITION" run-once="false" permanent="true">
		<Argument name="Tradition">TRADITION_ATLANTIS_JEC_SYNCRETISM_EXPLORATION</Argument>
	</Modifier>
	<Modifier id="MOD_UNLOCK_ATLANTIS_JEC_SYNCRETISM_MODERN" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_UNLOCK_TRADITION" run-once="false" permanent="true">
		<Argument name="Tradition">TRADITION_ATLANTIS_JEC_SYNCRETISM_MODERN</Argument>
	</Modifier>

	<!-- Syncretism -->
	<Modifier id="MOD_ATLANTIS_JEC_SYNCRETISM_EXPLORATION" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_IS_PRODUCING_PROJECT">
				<Argument name="ProjectType">PROJECT_TOWN_URBAN_CENTER</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_GOLD</Argument>
		<Argument name="Percent">10</Argument>
		<Argument name="Tooltip">LOC_TRADITION_ATLANTIS_JEC_SYNCRETISM_EXPLORATION_DESCRIPTION</Argument>
	</Modifier>

	<Modifier id="MOD_ATLANTIS_JEC_SYNCRETISM_MODERN" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_IS_PRODUCING_PROJECT">
				<Argument name="ProjectType">PROJECT_TOWN_URBAN_CENTER</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_GOLD</Argument>
		<Argument name="Percent">20</Argument>
		<Argument name="Tooltip">LOC_TRADITION_ATLANTIS_JEC_SYNCRETISM_MODERN_DESCRIPTION</Argument>
	</Modifier>


</GameEffects>